# App
APP_NAME=JDHub
APP_ENV=local
BACKEND_BIND=0.0.0.0
APP_PORT=3001
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=5173
TRUST_PROXY=0

# Frontend
VITE_API_BASE=http://localhost:3001
# Optional read-only demo portfolio bridge. Build-time settings; disabled by default.
VITE_PORTFOLIO_BRIDGE_ENABLED=false
# Exact canonical HTTPS parent origin, e.g. https://jdeere.net (no trailing slash).
VITE_PORTFOLIO_PARENT_ORIGIN=
# Independent Vite dev-server opt-in; parent is fixed to http://127.0.0.1:3300.
VITE_PORTFOLIO_DEV_BRIDGE_ENABLED=false

# MongoDB
MONGO_BIND=0.0.0.0
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=jdhub
MONGO_INITDB_ROOT_PASSWORD=change_me
MONGO_DATABASE=jdhub
MONGO_URI=mongodb://mongo:27017/jdhub

# Optional production resource ceilings. Defaults are sized for a small
# self-hosted instance and can be raised without changing compose files.
JDHUB_BACKEND_MEMORY_LIMIT=384m
JDHUB_BACKEND_CPU_LIMIT=1.0
JDHUB_FRONTEND_MEMORY_LIMIT=64m
JDHUB_FRONTEND_CPU_LIMIT=0.25
JDHUB_MONGO_MEMORY_LIMIT=768m
JDHUB_MONGO_CPU_LIMIT=1.0
JDHUB_MONGO_CACHE_GB=0.5
JDHUB_NODE_OPTIONS=--max-old-space-size=256

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
EMAIL_AUTH_REQUIRED=false
TRUSTED_BROWSER_DAYS=30
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALLOW_REGISTRATION=false
SITE_ADMIN_EMAIL=jundell.ggare@gmail.com
DEMO_AI_RATE_LIMIT_WINDOW_MS=3600000
DEMO_AI_RATE_LIMIT_MAX=20

# Browser access
# Comma-separated list. Example: https://jdhub.example.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Files
# Host folder mounted into the backend container. On the Acer server, use an
# absolute path if you want storage outside the JDHub repository.
FILE_STORAGE_PATH=./jdhub-cloud
FILE_TOTAL_QUOTA_GB=300
FILE_USER_QUOTA_GB=10
PUBLIC_SHARE_ORIGIN=https://share.jdeere.net

# Google Calendar OAuth (Google Cloud "Web application" client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google-calendar/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
APP_PUBLIC_ORIGIN=http://localhost:5173
# Comma-separated Name|URL entries checked by Administration > Security.
SECURITY_MONITORED_SERVICES=JDHub|https://jdhub.jdeere.net,TindaHub|https://tindahub.jdeere.net,n8n|https://n8n.jdeere.net,Kilos|https://kilos.jdeere.net

# Future integrations - leave blank until needed
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OLLAMA_BASE_URL=http://localhost:11434

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional paid consistency upgrade: openai/gpt-6-luna
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_REQUIRE_ZDR=false
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=JDHub
