# App
APP_NAME=JDHub
APP_ENV=local
BACKEND_BIND=0.0.0.0
APP_PORT=3001
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=5173
TRUST_PROXY=0

# Frontend
VITE_API_BASE=http://localhost:3001

# MongoDB
MONGO_BIND=0.0.0.0
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=jdhub
MONGO_INITDB_ROOT_PASSWORD=change_me
MONGO_DATABASE=jdhub
MONGO_URI=mongodb://mongo:27017/jdhub

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
EMAIL_AUTH_REQUIRED=false
TRUSTED_BROWSER_DAYS=30
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALLOW_REGISTRATION=false
SITE_ADMIN_EMAIL=jundell.ggare@gmail.com
DEMO_AI_RATE_LIMIT_WINDOW_MS=3600000
DEMO_AI_RATE_LIMIT_MAX=20

# Browser access
# Comma-separated list. Example: https://jdhub.example.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Files
# Host folder mounted into the backend container. On the Acer server, use an
# absolute path if you want storage outside the JDHub repository.
FILE_STORAGE_PATH=./jdhub-cloud
FILE_TOTAL_QUOTA_GB=300
FILE_USER_QUOTA_GB=10
PUBLIC_SHARE_ORIGIN=https://share.jdeere.net

# Future integrations - leave blank until needed
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OLLAMA_BASE_URL=http://localhost:11434

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional paid consistency upgrade: openai/gpt-6-luna
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_REQUIRE_ZDR=false
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=JDHub
